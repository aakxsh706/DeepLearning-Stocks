# Optional local overrides. Historical replay needs no credentials.
# scripts/dev.py loads .env automatically. Compose reads it for substitutions.
# DATABASE_URL=postgresql+psycopg://neurostock:neurostock-local@localhost:5432/neurostock
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
POSTGRES_USER=neurostock
POSTGRES_PASSWORD=neurostock-local
POSTGRES_DB=neurostock
# Credentials stay in the API process, never in VITE_* variables.
ALPHA_VANTAGE_API_KEY=
WORKER_POLL_SECONDS=1
TRAINING_STALE_SECONDS=900
EVENT_RETENTION=2000
